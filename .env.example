# ══════════════════════════════════════════════════════════════
# انسخ هذا الملف باسم .env ثم املأ القيم.  لا ترفع .env إلى GitHub أبداً.
# ══════════════════════════════════════════════════════════════

# ⚠️ إلزامي: توكن البوت من Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# اختياري (مستحسن): معرّف سيرفرك — يجعل أمر /roles يظهر فوراً بدل انتظار التحديث العالمي
GUILD_ID=

# اختياري: قائمة بيضاء — إن مُلئت يعمل البوت في هذه السيرفرات فقط ثم يخرج من غيرها تلقائياً
# مثال: ALLOWED_GUILD_IDS=123456789012345678,987654321098765432
ALLOWED_GUILD_IDS=

# تشغيل أمر !roles (يحتاج تفعيل Message Content Intent في لوحة المطوّرين)
# اتركه false إن كنت تكتفي بأمر /roles — وهذا أكثر أماناً
ENABLE_PREFIX_COMMANDS=false

# منفذ خادم الفحص — منصّات الاستضافة تضبطه تلقائياً، لا تغيّره إلا محلياً
PORT=8080
KEEPALIVE_PATH=/healthz

# اختياري: مفتاح يحمي نقطة الفحص (يُرسل في الهيدر X-Health-Key)
HEALTH_TOKEN=

# ⚠️ مهم للاستضافة المجانية: رابط التطبيق العام (بدون / في النهاية)
# البوت "يقرع" نفسه كل فترة حتى لا ينام السيرفر
PUBLIC_URL=
SELF_PING_SECONDS=600

# فترة منع التكرار بين ضغطات الأزرار (بالثواني) — حماية من السبام
ACTION_COOLDOWN_SECONDS=1
