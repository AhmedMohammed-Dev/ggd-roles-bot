# ══════════════════════════════════════════════════════════════════
# ✅ انسخ هذا الملف باسم  .deploy_secrets  واملأ فيه مفتاحين فقط
#    بعد ذلك شغّل:  python deploy.py
# ══════════════════════════════════════════════════════════════════
#
# 🔒 هذا الملف لا يُرفع إلى GitHub أبداً (مكتوب في .gitignore)،
#    وهو مختلف تماماً عن توكن البوت: هذان مفتاحان لخدمتين تسمحان
#    للبرنامج بأن يعمل مكانك — ويمكنك إلغاؤهما (Revoke) في أي لحظة.


# ────────────────────────────────────────────────────────────────
# 1) مفتاح GitHub  —  يسمح بإنشاء المستودع ورفع الكود مكانك
#    الرابط: https://github.com/settings/personal-access-tokens/new
#
#    الطريقة المضمونة (30 ثانية):
#      • Token name       : ggd-deploy
#      • Expiration       : 7 days  (تكفي تماماً)
#      • Repository access: All repositories
#      • Permissions → Repository permissions:
#            Administration : Read and write   ← مطلوبة لإنشاء المستودع
#            Contents       : Read and write   ← مطلوبة لرفع الكود
#      • Generate token ثم Copy والصقه أسفل السطر التالي
#
#    أو ببساطة: https://github.com/settings/tokens/new  (Classic)
#      واختر خانة  repo  فقط.
# ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=


# ────────────────────────────────────────────────────────────────
# 2) مفتاح Render API  —  يسمح بإنشاء الخدمة وضبط الإعدادات مكانك
#    الرابط: https://dashboard.render.com/u/settings#api-keys
#    اضغط  Create API Key  → اسمه ggd-deploy → Copy → الصقه أسفل السطر.
# ────────────────────────────────────────────────────────────────
RENDER_API_KEY=


# ────────────────────────────────────────────────────────────────
# إعدادات اختيارية (اتركها كما هي إلا لو أردت التغيير)
# ────────────────────────────────────────────────────────────────

# هل المستودع خاص أم عام؟
#   private : لا أحد يرى الكود. يحتاج أن تسمح لـ Render بالوصول لمستودعك مرة واحدة
#             (زر واحد في المتصفح) قبل تشغيل النشر.
#   public  : نشر كامل بلا أي خطوة في المتصفح — والكود لا يحتوي أي سرّ،
#             فالتوكن يُوضع في Render وليس في الملفات المرفوعة.
REPO_VISIBILITY=private

# منطقة سيرفر Render: frankfurt (الأقرب لمصر والشرق الأوسط) أو oregon أو ohio أو virginia أو singapore
RENDER_REGION=frankfurt

# اتركه فارغاً إلا لو كان في حسابك على Render أكثر من مساحة عمل (Workspace)
RENDER_OWNER_ID=
